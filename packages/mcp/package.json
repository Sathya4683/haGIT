    },
    "bugs": {
        "url": "https://github.com/Sathya4683/haGIT/issues"
    },
    "homepage": "https://github.com/Sathya4683/haGIT/tree/main/packages/mcp#readme",
    "dependencies": {
        "@modelcontextprotocol/server": "^2.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@hagit/coach-core": "*",
