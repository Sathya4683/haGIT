generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime connection. On Supabase use the pooled URL (port 6543, ?pgbouncer=true&connection_limit=1).
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection (port 5432).
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String?
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role      @default(USER)
  // Bumped to revoke every API token issued to this user.
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())

  commits   Commit[]
  habits    Habit[]
  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
}

// Record of privileged actions taken in the admin console.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Habit {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  createdAt DateTime @default(now())
  commits   Commit[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Commit {
  id        Int      @id @default(autoincrement())
  message   String
  timestamp DateTime
  habitId   Int
  userId    Int
  // Client-generated id (CLI / extension) that makes pushes safe to retry.
  clientId  String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([habitId])
  @@index([userId, timestamp])
}

// Auth.js v5 Prisma adapter tables.
// IDs are Int to match existing User.id (NOT String/cuid like the stock adapter schema).
// Reference: https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
