{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ],
            "env": [
                "DATABASE_URL",
                "DIRECT_URL",
                "APP_URL",
                "ADMIN_HOST",
                "JWT_SECRET",
                "AUTH_*",
                "REDIS_*",
                "UPSTASH_*",
                "GEMINI_*",
                "EMBEDDINGS_PROVIDER",
                "CLOUDFLARE_*",
                "NTFY_*",
                "SMTP_*",
                "MAIL_FROM",
                "CRON_SECRET",
                "QSTASH_*",
                "REVALIDATE_SECRET",
                "LOKI_*",
                "METRICS_TOKEN",
                "LOG_LEVEL",
                "VERCEL_GIT_COMMIT_SHA"
            ]
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "typecheck": {
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
