# Copy to .env on the VM (this file's directory) and fill in.
COMPOSE_PROFILES=observability,edge,cron

# Public hostname for Caddy; certificates come from Let's Encrypt automatically.
# With infra/terraform this is hagit-<ip-with-dashes>.sslip.io.
DOMAIN=hagit-1-2-3-4.sslip.io

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://hagit-1-2-3-4.sslip.io

# Prometheus scrapes production with this config and bearer token (must equal the app's METRICS_TOKEN).
PROMETHEUS_CONFIG=prometheus.prod.yml
METRICS_TOKEN=

# Basic auth for the app's Loki push endpoint. Generate the hash with:
#   docker run --rm caddy:2.9-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the bcrypt hash contains '$'.
LOKI_PUSH_USER=hagit
LOKI_PUSH_HASH=''

# Alert delivery (Grafana → email + ntfy)
ALERT_EMAIL=you@example.com
NTFY_ALERT_URL=https://ntfy.sh/your-random-admin-topic
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=you@gmail.com
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=you@gmail.com
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS

# Job scheduler (profile "cron"): must equal the app's CRON_SECRET.
CRON_SECRET=
TICK_URL=https://hagithub.vercel.app/api/jobs/tick
