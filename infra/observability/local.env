# Settings for the local observability stack, used by the root docker-compose.yml.
# They keep a production .env in this directory (written by infra/terraform/deploy.sh) from
# leaking into local development: production secrets, the production scrape config and the
# production alert topic.
PROMETHEUS_CONFIG=prometheus.local.yml
METRICS_TOKEN=local-metrics-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
NTFY_ALERT_URL=http://ntfy/hagit-alerts
ALERT_EMAIL=admin@hagit.local
GF_SMTP_ENABLED=true
GF_SMTP_HOST=mailpit:1025
GF_SMTP_FROM_ADDRESS=alerts@hagit.local
GF_SMTP_STARTTLS_POLICY=NoStartTLS
