        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(count_over_time({service=\"hagit-web\", kind=\"http\"} | json | status >= 500 [$__range])) or vector(0)) / sum(count_over_time({service=\"hagit-web\", kind=\"http\"} [$__range])) * 100",
