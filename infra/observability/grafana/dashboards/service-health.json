        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (route) (count_over_time({service=\"hagit-web\", kind=\"http\"} | json | keep route [$__range])))",
          "legendFormat": "",
          "queryType": "instant"
