# ── Existing ────────────────────────────────────────────────────────────────
DATABASE_URL=
JWT_SECRET=

# Rate limiting provider: use `local` for Docker Redis, or `upstash` in production.
# This is an explicit provider choice; it is not inferred from NODE_ENV.
REDIS_PROVIDER=local
# Local connection string (Compose publishes container Redis on host port 6381).
REDIS_URL=redis://localhost:6381
# For Upstash, change REDIS_PROVIDER=upstash and provide the REST URL and token:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=

# Optional locally; required in production. Inferred from request on Vercel.
AUTH_URL=http://localhost:3000

# ── OAuth provider credentials ─────────────────────────────────────────────
# Auth.js v5 reads these by provider id automatically.
# Get values from each provider's developer console (see steps.md).

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
