# ── Existing ────────────────────────────────────────────────────────────────
DATABASE_URL=
JWT_SECRET=

# ── Auth.js v5 ──────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=

# Optional locally; required in production. Inferred from request on Vercel.
AUTH_URL=http://localhost:3000

# ── OAuth provider credentials ─────────────────────────────────────────────
# Auth.js v5 reads these by provider id automatically.
# Get values from each provider's developer console (see steps.md).

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
