# haGIT web app configuration.
# Copy to apps/web/.env (Next.js) and to the repo root .env (Prisma CLI).
# Values below are the local defaults for `docker compose up`.

# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection. Supabase: pooled URL (port 6543) with ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://hagit:hagit@localhost:5434/hagit
# Direct connection used by `prisma migrate` (Supabase: port 5432)
DIRECT_URL=postgresql://hagit:hagit@localhost:5434/hagit

# ── App URLs ────────────────────────────────────────────────────────────────
# Public base URL, used in email and notification links.
APP_URL=http://localhost:3000
# Hostname that serves the admin console. Leave empty to serve it at /admin on the main host.
# Production: hagithub-admin.vercel.app
ADMIN_HOST=admin.localhost:3000

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs CLI / extension / dashboard API tokens. Required in production: openssl rand -base64 32
JWT_SECRET=
# Auth.js secret: npx auth secret
AUTH_SECRET=
# Leave unset (commented out) so Auth.js uses the request host; required for the admin host.
# Setting it pins every Auth.js redirect to one origin.
# AUTH_URL=http://localhost:3000

# OAuth providers (Auth.js reads these by provider id).
# Google: add redirect URIs for every host, e.g. https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# GitHub OAuth Apps allow one callback host, so the admin host needs its own app, with the
# callback URL https://<ADMIN_HOST>/api/auth/callback/github-admin. Empty hides the button.
AUTH_GITHUB_ADMIN_ID=
AUTH_GITHUB_ADMIN_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────────────
# `local` uses REDIS_URL; `upstash` uses the REST credentials. When unset, Upstash is used
# if its credentials are present.
REDIS_PROVIDER=local
REDIS_URL=redis://localhost:6381
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Habit coach ─────────────────────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey. Empty disables the coach (503).
GEMINI_API_KEY=
# Optional model override. Default: gemini-flash-lite-latest
GEMINI_MODEL=

# ── Knowledge base embeddings ───────────────────────────────────────────────
# `local` runs bge-small-en-v1.5 in-process (model fetched by `npm run fetch-model`).
# `cloudflare` calls Workers AI with the same model (@cf/baai/bge-small-en-v1.5).
EMBEDDINGS_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# ── Notifications (ntfy) ────────────────────────────────────────────────────
# Server the app publishes to.
NTFY_BASE_URL=http://localhost:8090
# Server users subscribe to (shown in Settings). Defaults to NTFY_BASE_URL.
NTFY_PUBLIC_URL=
# Prefix for generated per-user topics: <prefix>-<random>
NTFY_TOPIC_PREFIX=hagit
# Access token, only needed for a self-hosted ntfy server with auth enabled.
NTFY_TOKEN=

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Local: Mailpit (http://localhost:8025). Gmail: smtp.gmail.com / 465 / true / your address /
# a 16-character app password (requires 2-Step Verification).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="haGIT <no-reply@hagit.local>"

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Bearer secret accepted by POST /api/jobs/tick (local scheduler, manual runs).
CRON_SECRET=local-cron-secret
# Upstash QStash (production scheduler). Signing keys verify requests; the token is only
# used by `npm run jobs:schedule` to create the hourly schedule.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Secret for POST /api/revalidate (used by CI after syncing knowledge-base content).
REVALIDATE_SECRET=

# ── Observability ───────────────────────────────────────────────────────────
# Loki push endpoint. Local stack: http://localhost:3100/loki/api/v1/push (no auth).
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
# Bearer token Prometheus uses to scrape /api/metrics. Empty disables the endpoint.
METRICS_TOKEN=local-metrics-token
# debug | info | warn | error
LOG_LEVEL=info
# Optional: Grafana URL linked from the admin console overview.
GRAFANA_URL=
